# --- CONTAINER VERSIONS ---
FRONTEND_VERSION=v1.0.0
BACKEND_VERSION=v1.0.0
SPRING_PROFILES_ACTIVE=dev,test


# ── 1. CẤU HÌNH BẢO MẬT NỘI BỘ ──────────────────
DB_PASSWORD=your_postgres_password
REDIS_PASSWORD=your_redis_password
JWT_SECRET=your_jwt_secret_key_at_least_256_bits
QR_SECRET=your_qr_secret_key

# ── 2. CẤU HÌNH CLOUDINARY ────────────
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRECT=your_cloudinary_api_secret

# ── 3. CẤU HÌNH VNPAY SANDBOX ─────────
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
FRONTEND_URL=https://localhost
VNPAY_RETURN_URL=https://localhost/api/v1/payment/vnpay-return
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# ── 4. CẤU HÌNH ĐĂNG NHẬP MẠNG XÃ HỘI ─────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ── 5. EMAIL CONFIG───────────
EMAIL_USERNAME=test@novaticket.com
EMAIL_PASSWORD=anydummy_password
