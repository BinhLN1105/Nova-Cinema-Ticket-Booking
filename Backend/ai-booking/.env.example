# ── Server ────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development          # development | production

# ── Java Spring Boot ──────────────────────────
JAVA_API_BASE=http://localhost:8080
INTERNAL_API_KEY=your_internal_secret_key_here

# ── LLM (OpenRouter / Gemini / OpenAI) ───────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat
LLM_FALLBACK_MODELS=qwen/qwen-2.5-72b-instruct:free,mistralai/mistral-7b-instruct:free,meta-llama/llama-3.1-70b-instruct:free
LLM_TEMPERATURE=0.0          # 0.0: Chuẩn enterprise, trung thực với dữ liệu, chống hallucination
LLM_TIMEOUT=8.0              # Thời gian chờ tối đa (giây) cho mỗi model AI
LLM_MAX_TOKENS=1024          # Số lượng token tối đa câu trả lời
USE_MOCK_AI=false            # false: Kích hoạt OpenRouter LLM (tự động fallback về template khi lỗi/ratelimit)

# ── Vector DB (FAISS local) ──────────────────
VECTOR_DB_DIR=./faiss_index
CHROMA_COLLECTION=nova_knowledge

# ── Embedding Model (Cohere API) ─────────────
COHERE_API_KEY=your_cohere_api_key_here
EMBEDDING_MODEL=embed-multilingual-v3.0

# ── Chunking ──────────────────────────────────
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# ── Security ──────────────────────────────────
JWT_SECRET=your_jwt_secret_matching_backend
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
